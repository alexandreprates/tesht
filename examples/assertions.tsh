# A command without output can be checked by its exit status.
test mkdir -p "$TESHT_TMPDIR/foo/bar"
assert_success
assert_dir "$TESHT_TMPDIR/foo/bar"

# A directory change persists until the end of this test file.
test cd "$TESHT_TMPDIR/foo/bar"
assert_success
test pwd
assert_stdout_equal "$TESHT_TMPDIR/foo/bar"$'\n'

# Output assertions with a _match suffix explicitly use regular expressions.
test cd "$TESHT_TMPDIR/missing"
assert_fail
assert_stderr_match '[Nn]o such file or directory'
