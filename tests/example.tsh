# Create fixtures inside the scratch directory managed by the runner.
test mkdir -p "$TESHT_TMPDIR/foo/bar"
assert_success
assert_dir "$TESHT_TMPDIR/foo/bar"

# Commands in this file share their working directory.
test cd "$TESHT_TMPDIR/foo/bar"
assert_success
test pwd
assert_stdout_equal "$TESHT_TMPDIR/foo/bar"$'\n'

# Failed commands are captured and can be asserted explicitly.
test cd "$TESHT_TMPDIR/missing"
assert_fail
assert_stderr '[Nn]o such file or directory'

test touch "$TESHT_TMPDIR/foo/bar/test.txt"
assert_success
assert_file "$TESHT_TMPDIR/foo/bar/test.txt"
